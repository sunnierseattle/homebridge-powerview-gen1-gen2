{
  "pluginAlias": "PowerView",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "PowerView"
      },
      "host": {
        "title": "Hub host",
        "type": "string",
        "description": "Hostname or IP of the PowerView hub.",
        "placeholder": "powerview-hub.local"
      },
      "refreshShades": {
        "title": "Ask shades on every HomeKit read",
        "type": "boolean",
        "default": false,
        "description": "Off by default. Each time the Home app reads a position, ask shades instead of hub. Wakes a motor every time, even during quiet hours."
      },
      "pollShadesForUpdate": {
        "title": "Ask hub every 30 seconds",
        "type": "boolean",
        "default": false,
        "description": "Pick up any position changes the hub has stored. Never wakes a motor."
      },
      "strictErrors": {
        "title": "Strict errors",
        "type": "boolean",
        "default": false,
        "description": "When enabled, HomeKit reads fail on hub errors instead of returning the last known position."
      },
      "healSweepIntervalMinutes": {
        "title": "Ask shades every (minutes)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "0 is off, the default. Otherwise ask shades, one at a time, at this interval (at least 30), so moves made with a physical remote or the PowerView app show up. 720 (twice a day) is a good start."
      },
      "healSweepGapMs": {
        "title": "Pause between shades (ms)",
        "type": "integer",
        "default": 4000,
        "minimum": 1000,
        "description": "Pause after each shade, so hub and radio handle one shade at a time. Applies to asking shades on schedule and after a move.",
        "condition": {
          "functionBody": "return model.healSweepIntervalMinutes > 0 || model.verifyAfterMove === true;"
        }
      },
      "batteryPolling": {
        "title": "Daily battery poll",
        "type": "boolean",
        "default": false,
        "description": "Off by default. When enabled, refreshes shade battery levels once a day. Each poll wakes every shade motor over RF: it is audible and nudges the shade, so do not schedule it near sleeping hours. Battery level still reaches HomeKit from ordinary hub reads without this."
      },
      "batteryPollAt": {
        "title": "Battery poll time",
        "type": "string",
        "default": "14:00",
        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
        "placeholder": "14:00",
        "description": "Local time of day (HH:MM) for the daily battery poll.",
        "condition": {
          "functionBody": "return model.batteryPolling === true;"
        }
      },
      "syncPositionsOnStart": {
        "title": "Ask shades at startup",
        "type": "boolean",
        "default": true,
        "description": "Once, when the plugin starts, ask shades the hub has no position for. Without this, a shade moved by remote can show the wrong position until it next moves."
      },
      "quietHours": {
        "title": "Quiet hours",
        "type": "object",
        "description": "Hours when the plugin won't ask shades at startup or on the schedule above. Asking shades after a move still runs. Pick the same hour twice to turn this off.",
        "properties": {
          "start": {
            "title": "Quiet from (hour)",
            "type": "integer",
            "default": 21,
            "minimum": 0,
            "maximum": 23
          },
          "end": {
            "title": "Quiet until (hour)",
            "type": "integer",
            "default": 8,
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "forceRollerShades": {
        "title": "Force roller shade IDs",
        "type": "array",
        "items": {
          "type": "integer"
        },
        "description": "Treat these shade IDs as roller shades regardless of hub type."
      },
      "forceTopBottomShades": {
        "title": "Force top/bottom shade IDs",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "forceHorizontalShades": {
        "title": "Force horizontal vane shade IDs",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "forceVerticalShades": {
        "title": "Force vertical vane shade IDs",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "requestIntervalMs": {
        "title": "Hub request spacing (ms)",
        "type": "integer",
        "default": 100,
        "minimum": 0,
        "maximum": 1000,
        "description": "Delay between requests to the hub, which answers one at a time. Lowering it feels faster but a legacy hub drops connections when commands arrive too quickly \u2014 25ms was tried and lost shades from group moves. Raise it if your hub returns errors or truncated responses under load."
      },
      "exposeScenes": {
        "title": "Expose hub scenes as switches",
        "type": "boolean",
        "default": true,
        "description": "Publish each PowerView scene as a HomeKit switch. Activating one is a single hub call that moves the whole group together, which individual shade commands cannot match. Nothing appears if you have no scenes defined in the PowerView app."
      },
      "excludeScenes": {
        "title": "Hide these scenes",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Scene name or ID"
        },
        "description": "Scenes to keep out of HomeKit, such as ones that exist only for a physical remote. Enter the name as the PowerView app shows it (case-insensitive) or the numeric hub scene ID. A scene already in HomeKit is removed.",
        "condition": {
          "functionBody": "return model.exposeScenes !== false;"
        }
      },
      "sceneNamePrefix": {
        "title": "Scene name prefix",
        "type": "string",
        "placeholder": "Scene: ",
        "description": "Text put in front of each scene switch's name, so scenes are easy to tell apart from shades in the Home app. Applies to scenes added from now on; existing switches keep their names.",
        "condition": {
          "functionBody": "return model.exposeScenes !== false;"
        }
      },
      "reportTravel": {
        "title": "Animate shade travel in HomeKit",
        "type": "boolean",
        "default": false,
        "description": "Off by default: the tile shows the position you asked for as soon as you tap, which is responsive but is ahead of the shade while it moves. Turn on to keep the tile on the real position and show opening/closing during travel \u2014 truer, but the number does not change for several seconds."
      },
      "verifyAfterMove": {
        "title": "Ask shades after a move",
        "type": "boolean",
        "default": false,
        "description": "Off by default. After a shade is moved, from HomeKit or a scene, ask shades where it ended up, so a motor that stopped short shows its real position instead of the target. Several moves in a row get one ask, after the last. Shades are asked one at a time, with the pause below between them. This wakes the motor shortly after it stops, even during quiet hours."
      },
      "verifyDelayMs": {
        "title": "Wait before asking (ms)",
        "type": "integer",
        "default": 30000,
        "minimum": 5000,
        "maximum": 300000,
        "description": "How long after the last command to ask shades. Long enough for a full travel to finish; raise it if you have large or heavy shades.",
        "condition": {
          "functionBody": "return model.verifyAfterMove === true;"
        }
      },
      "setPositionDebounceMs": {
        "title": "Wait for slider to settle (ms)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 5000,
        "description": "0 is off, the default. Otherwise wait this long after the last slider value before moving the shade, so a drag sends one move. Every command waits, including taps, Siri and automations. 1500 is a good start."
      }
    }
  },
