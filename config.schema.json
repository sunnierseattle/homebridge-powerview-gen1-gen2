{
  "pluginAlias": "PowerView",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "PowerView"
      },
      "host": {
        "title": "Hub address",
        "type": "string",
        "description": "The hub's name or IP address. Leave blank to use powerview-hub.local.",
        "placeholder": "powerview-hub.local"
      },
      "refreshShades": {
        "title": "Ask shades on every HomeKit read",
        "type": "boolean",
        "default": false,
        "description": "Ask shades, not the hub, each time the Home app shows a position. This wakes the motor every time, even in quiet hours."
      },
      "pollShadesForUpdate": {
        "title": "Ask hub every 30 seconds",
        "type": "boolean",
        "default": false,
        "description": "Pick up any position changes the hub has stored. Never wakes a motor."
      },
      "strictErrors": {
        "title": "Show hub errors",
        "type": "boolean",
        "default": false,
        "description": "If the hub can't give a shade's position, the Home app shows an error instead of the last known position."
      },
      "healSweepIntervalMinutes": {
        "title": "Ask shades every (minutes)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Ask shades where they are, one at a time, this often. This catches moves made with a remote or the PowerView app. 0 is off. The minimum is 30. Try 720, twice a day."
      },
      "healSweepGapMs": {
        "title": "Pause between shades (ms)",
        "type": "integer",
        "default": 4000,
        "minimum": 1000,
        "description": "Pause between shades when asking several. The hub's radio handles one at a time. Used by \"Ask shades every (minutes)\" and \"Ask shades after a move\".",
        "condition": {
          "functionBody": "return model.healSweepIntervalMinutes > 0 || model.verifyAfterMove === true;"
        }
      },
      "batteryPolling": {
        "title": "Refresh battery daily",
        "type": "boolean",
        "default": false,
        "description": "Refresh battery levels once a day. This wakes each supported shade with a sound and small nudge. Quiet hours do not apply, so pick a daytime hour. Battery levels can still reach the Home app without this."
      },
      "batteryPollAt": {
        "title": "Daily refresh time",
        "type": "string",
        "default": "14:00",
        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
        "placeholder": "14:00",
        "description": "Local time, as HH:MM.",
        "condition": {
          "functionBody": "return model.batteryPolling === true;"
        }
      },
      "syncPositionsOnStart": {
        "title": "Ask shades at startup",
        "type": "boolean",
        "default": true,
        "description": "At startup, ask shades the hub has no position for. Otherwise a shade moved by remote may show the wrong position until it moves again."
      },
      "quietHours": {
        "title": "Quiet hours",
        "type": "object",
        "description": "During these hours, the plugin won't ask shades at startup or on a schedule. Still allowed: \"Ask shades after a move\", \"Ask shades on every HomeKit read\", \"Refresh battery daily\", checks after a stop, Check in Shade tools, and any shade with an unknown position. Set both to the same hour to turn this off.",
        "properties": {
          "start": {
            "title": "Quiet from (hour)",
            "type": "integer",
            "default": 21,
            "minimum": 0,
            "maximum": 23
          },
          "end": {
            "title": "Quiet until (hour)",
            "type": "integer",
            "default": 8,
            "minimum": 0,
            "maximum": 23
          }
        }
      },
      "forceRollerShades": {
        "title": "Roller",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "forceTopBottomShades": {
        "title": "Top-down/bottom-up",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "forceHorizontalShades": {
        "title": "Horizontal vanes",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "forceVerticalShades": {
        "title": "Vertical vanes",
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "requestIntervalMs": {
        "title": "Hub request spacing (ms)",
        "type": "integer",
        "default": 100,
        "minimum": 0,
        "maximum": 1000,
        "description": "Time between messages to the hub. Lower is faster, but the hub may miss commands. Raise it if you see errors."
      },
      "exposeScenes": {
        "title": "Show scenes as switches",
        "type": "boolean",
        "default": true,
        "description": "Each PowerView scene becomes a switch in the Home app. A scene moves all its shades together. No switches appear until you create scenes in the PowerView app."
      },
      "excludeScenes": {
        "title": "Hide these scenes",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Scene name or ID"
        },
        "description": "Scenes to keep out of the Home app, such as ones only for a remote. Enter the name from the PowerView app, or the scene ID. A scene already in the Home app is removed.",
        "condition": {
          "functionBody": "return model.exposeScenes !== false;"
        }
      },
      "sceneNamePrefix": {
        "title": "Scene name prefix",
        "type": "string",
        "placeholder": "Scene: ",
        "description": "Text before each scene's name, so scenes stand apart from shades. Applies to new scenes only.",
        "condition": {
          "functionBody": "return model.exposeScenes !== false;"
        }
      },
      "reportTravel": {
        "title": "Show estimated travel",
        "type": "boolean",
        "default": false,
        "description": "Off: the tile shows where the shade is going. On: it shows the shade opening or closing, with an estimated position that updates more slowly."
      },
      "stopCommand": {
        "title": "Offer stop",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "On for Gen 2 hubs only (recommended)",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "On",
            "enum": [
              "on"
            ]
          },
          {
            "title": "Off",
            "enum": [
              "off"
            ]
          }
        ],
        "description": "Adds a stop control to each shade, for apps that show it. Gen 2 hubs stop the shade. Gen 1 hubs ignore it, so the default turns it on only for Gen 2. The Home app and Siri don't show it; use the Stop Shades switch. After a stop, the plugin checks where the shade stopped, which wakes the motor."
      },
      "stopSwitch": {
        "title": "Stop Shades switch",
        "type": "boolean",
        "default": false,
        "description": "One switch that stops every shade at once, then checks where each one stopped. Works in the Home app and with Siri (\"turn on Stop Shades\"). Needs Offer stop on.",
        "condition": {
          "functionBody": "return model.stopCommand !== 'off';"
        }
      },
      "verifyAfterMove": {
        "title": "Ask shades after a move",
        "type": "boolean",
        "default": false,
        "description": "After a move from Home, Siri, an automation, or a scene, check where the shade stopped. Several quick moves get one check, after the last. Checks share the pause below. This wakes the motor, even in quiet hours."
      },
      "verifyDelayMs": {
        "title": "Wait before asking (ms)",
        "type": "integer",
        "default": 30000,
        "minimum": 5000,
        "maximum": 300000,
        "description": "How long to wait after the last move. Allow time for a full open or close. Raise it for large or heavy shades.",
        "condition": {
          "functionBody": "return model.verifyAfterMove === true;"
        }
      },
      "setPositionDebounceMs": {
        "title": "Wait for slider to settle (ms)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 5000,
        "description": "Wait this long after you stop dragging, so one drag sends one move. Every command waits, including taps, Siri and automations. 0 is off. Try 1500."
      },
      "stopBeforeRetarget": {
        "title": "Stop before changing course",
        "type": "boolean",
        "default": false,
        "description": "When a moving shade gets a new position, stop it, wait 2 seconds, then send the new one. Changing course mid-move can leave a shade in the wrong place. Skipped if another part of the same shade is moving (top-down/bottom-up shades). Adds about 4 seconds. Needs Offer stop on."
      }
    }
  },
  "form": [
